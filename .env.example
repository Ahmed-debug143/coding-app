# Base and upload storage
AULA_DATA=C:\chemin\vers\campusia-data

# HTTP deployment
AULA_HOST=127.0.0.1
AULA_PORT=8765
AULA_CORS_ORIGINS=https://campusia.example.edu

# Optional external AI provider
AULA_AI_API_KEY=
AULA_AI_BASE_URL=https://api.openai.com/v1
AULA_AI_MODEL=gpt-4o-mini

# Development-only reset-link visibility
AULA_EXPOSE_RESET_LINKS=0
AULA_RESET_BASE_URL=https://campusia.example.edu

# SMTP for password reset emails
AULA_SMTP_HOST=
AULA_SMTP_PORT=587
AULA_SMTP_USER=
AULA_SMTP_PASSWORD=
AULA_SMTP_FROM=
AULA_SMTP_TLS=1
